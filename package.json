{
  "name": "kotodama",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kotodama (言霊): an offline-first PWA that teaches Japanese as a hardcore game.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "content:lint": "tsx tools/content-lint.ts",
    "schema:gen": "tsx tools/gen-schema.ts",
    "voice:build": "tsx tools/voice-build.ts",
    "voice:audition": "tsx tools/voice-audition.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run content:lint && npm run build && npm run e2e",
    "voice:app": "tsx tools/voice-app.ts"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "lottie-web": "^5.13.0",
    "motion": "^14.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "ts-fsrs": "^6.0.0",
    "wanakana": "^5.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@breezystack/lamejs": "^1.2.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wanakana": "^4.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
