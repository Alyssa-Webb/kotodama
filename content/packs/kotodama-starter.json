      "id": "p.hajimemashite",
      "kind": "phrase",
      "text": "はじめまして",
      "register": "polite",
      "meanings": ["Nice to meet you", "How do you do"],
      "literal": "(This is) the first time.",
      "usage": "Said when you meet someone for the first time, usually followed by your name."
    },
    {
      "id": "p.sumimasen",
      "kind": "phrase",
      "text": "すみません",
      "register": "polite",
      "meanings": ["Excuse me", "Sorry"],
      "usage": "Calls a server over, apologizes lightly, or thanks someone who went out of their way."
    },
    {
      "id": "p.arigatou-gozaimasu",
      "kind": "phrase",
      "text": "ありがとうございます",
      "register": "polite",
      "meanings": ["Thank you", "Thank you very much"],
      "usage": "The polite thank-you for staff, strangers and anyone older than you.",
      "variants": [
        {
          "text": "ありがとう",
          "register": "casual"
        }
      ],
      "tiles": ["ありがとう", "ございます"]
    },
    {
      "id": "p.irasshaimase",
      "kind": "phrase",
      "text": "いらっしゃいませ",
      "register": "formal",
      "meanings": ["Welcome", "Welcome to our shop"],
      "usage": "Shop and restaurant staff say this when you walk in. Customers don't say it back; a nod is enough."
    },
    {
      "id": "p.gochisousama",
      "kind": "phrase",
      "text": "ごちそうさまでした",
      "register": "polite",
      "meanings": ["Thank you for the meal"],
      "usage": "Said after finishing a meal: to the cook, your host, or the staff as you leave.",
      "variants": [
        {
          "text": "ごちそうさま",
          "register": "casual"
        }
      ],
      "tiles": ["ごちそうさま", "でした"]
    },
    {
      "id": "g.o-kudasai",
      "kind": "pattern",
      "pattern": "{{thing}}をください",
      "slots": {
        "thing": [
          "w.mizu",
          "w.koohii",
          "w.ocha",
          "w.koucha",
          "w.juusu",
          "w.gyuunyuu",
          "w.pan",
          "w.keeki",
          "w.sandoicchi",
          "w.kore"
        ]
      },
      "meanings": ["please give me ...", "..., please"],
      "meaningPattern": "{{thing}}, please",
      "notes": "Name the thing, then を (said \"o\"), then ください.",
      "examples": [
        {
          "text": "{水|みず}をください。",
          "en": "Water, please."
        },
        {
          "text": "これをください。",
          "en": "This one, please."
        }
      ]
    },
    {
      "id": "s.mizu-o-kudasai",
      "kind": "sentence",
      "text": "{水|みず}をください。",
      "register": "polite",
