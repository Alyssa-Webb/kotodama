    {
      "id": "s.menyuu-o-onegaishimasu",
      "kind": "sentence",
      "text": "メニューをお{願|ねが}いします。",
      "register": "polite",
      "meanings": ["The menu, please.", "Menu, please.", "Could I have the menu?"],
      "tiles": ["メニュー", "を", "お{願|ねが}いします", "。"]
    },
    {
      "id": "s.kore-wa-nan-desu-ka",
      "kind": "sentence",
      "text": "これは{何|なん}ですか。",
      "register": "polite",
      "meanings": ["What is this?", "What's this?"],
      "tiles": ["これ", "は", "{何|なん}", "ですか", "。"]
    },
    {
      "id": "s.oishii-desu",
      "kind": "sentence",
      "text": "おいしいです。",
      "register": "polite",
      "meanings": ["It's delicious.", "It's tasty.", "This is delicious."],
      "tiles": ["おいしい", "です", "。"]
    },
    {
      "id": "s.okaikei",
      "kind": "sentence",
      "text": "お{会計|かいけい}をお{願|ねが}いします。",
      "register": "polite",
      "meanings": ["The check, please.", "The bill, please.", "Check, please."],
      "tiles": ["お{会計|かいけい}", "を", "お{願|ねが}いします", "。"]
    }
  ],
  "dialogues": [
    {
      "id": "d.cafe-order",
      "title": "Ordering at the café",
      "setting": "A small café by the station, mid-morning",
      "lines": [
        {
          "speaker": "clerk",
          "text": "いらっしゃいませ。",
          "en": "Welcome."
        },
        {
          "speaker": "player",
          "text": "すみません、メニューをお{願|ねが}いします。",
          "en": "Excuse me, the menu, please.",
          "choices": [
            {
              "text": "すみません、メニューをお{願|ねが}いします。",
              "correct": true,
              "feedback": "Polite and natural."
            },
            {
              "text": "いただきます。",
              "correct": false,
              "feedback": "You say that right before eating, not to ask for something."
            },
            {
              "text": "はじめまして。",
              "correct": false,
              "feedback": "That is for meeting someone for the first time."
            }
          ]
        },
        {
          "speaker": "clerk",
          "text": "はい、どうぞ。",
          "en": "Here you are."
        },
        {
          "speaker": "player",
          "text": "コーヒーを{一|ひと}つください。",
          "en": "One coffee, please.",
          "choices": [
            {
              "text": "コーヒーを{一|ひと}つください。",
              "correct": true,
              "feedback": "The thing, を, how many, ください. Perfect."
            },
            {
              "text": "コーヒーです。",
              "correct": false,
              "feedback": "That means 'It is coffee', not a request."
            },
            {
              "text": "ごちそうさまでした。",
              "correct": false,
              "feedback": "That is what you say after a meal."
            }
          ]
        },
        {
          "speaker": "clerk",
          "text": "かしこまりました。{少々|しょうしょう}お{待|ま}ちください。",
          "en": "Certainly. One moment, please."
        },
        {
          "speaker": "clerk",
          "text": "お{待|ま}たせしました。コーヒーです。",
          "en": "Sorry to keep you waiting. Your coffee."
        },
        {
          "speaker": "player",
          "text": "ありがとうございます。",
          "en": "Thank you.",
          "choices": [
            {
              "text": "ありがとうございます。",
              "correct": true,
              "feedback": "Polite thanks to the staff."
            },
            {
              "text": "いらっしゃいませ。",
              "correct": false,
              "feedback": "Only shop staff say that."
            }
          ]
        },
        {
          "speaker": "player",
          "text": "いただきます。",
          "en": "(before the first sip) Let's eat.",
          "choices": [
            {
              "text": "いただきます。",
              "correct": true,
              "feedback": "Said right before eating or drinking."
            },
            {
              "text": "ごちそうさまでした。",
              "correct": false,
              "feedback": "That one comes after you finish."
            }
          ]
        }
      ]
    }
  ],
